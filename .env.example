# Copy this file to .env and fill in your keys:
#   copy .env.example .env

# Required for title, summary, insights, and chat (free at https://console.groq.com)
GROQ_API_KEY=your_groq_api_key_here

# Optional: smaller = faster (tiny | base | small | medium | large)
WHISPER_MODEL=base

# Optional: stable cookie signing (auto-generated if unset — set for production)
# SECRET_KEY=change-me-to-a-long-random-string

# Optional: LAN / phone access (default in app is 0.0.0.0)
# HOST=0.0.0.0
# PORT=5000

# Optional: for Hinglish speech-to-text
# SARVAM_API_KEY=

# Production / Docker
# WHISPER_MODEL=tiny
# WEB_CONCURRENCY=1
# GUNICORN_TIMEOUT=600

